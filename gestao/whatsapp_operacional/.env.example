# Copie pra .env (nunca commitar o .env de verdade) e preencha.
# MODO=teste e' o padrao mesmo sem essa linha — so mude pra producao
# quando tudo mais aqui estiver preenchido e testado.

WHATSAPP_MODO=teste

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Pasta onde a sessao do Baileys fica salva (multi-file auth state).
# Relativa a esta pasta por padrao; na migracao pra VPS, aponte pro
# caminho do volume persistente — so isso muda, o codigo nao.
WHATSAPP_SESSAO_DIR=./sessao

# Nome/foto do perfil do numero operacional, configurados na primeira
# conexao (npm run conectar) — pra nao aparecer como numero desconhecido
# administrando o grupo.
WHATSAPP_PERFIL_NOME=CIO Cerrado
WHATSAPP_PERFIL_FOTO_PATH=

WHATSAPP_POLL_INTERVALO_MS=15000

# [PREENCHER] Google People API — nao e' service account (ver comentario
# em google_contacts.js pro motivo). Gerar seguindo o passo a passo do
# README.md, secao "Primeira autorizacao do Google People API".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
